#!/usr/bin/env bash
# MR AI boshqaruvi:  mrai start | stop | restart | status | logs
#
# Servislar kompyuter yoqilganda O'ZLARI ishga tushadi (systemd --user + linger), shuning uchun
# `mrai start` odatda kerak emas: u faqat `mrai stop` dan keyin qayta yoqish uchun.
# `mrai stop` vaqtincha: kompyuter qayta yoqilganda hammasi yana o'zi ishga tushadi.
set -u

UNITS=(mrai.service mrai-web.service mrai-edge.service)   # tartib: python server -> web -> edge
LOG_DIR="$HOME/MR/mrai"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

sc() { systemctl --user "$@"; }
label() { case "$1" in mrai.service) echo "Python server  :8080";; mrai-web.service) echo "Web (Next)     :3000";; mrai-edge.service) echo "Edge proxy     :7780";; *) echo "$1";; esac; }
state() { sc is-active "$1" 2>/dev/null || true; }

show_status() {
  for u in "${UNITS[@]}"; do
    s="$(state "$u")"
    if [ "$s" = "active" ]; then mark="●"; else mark="○"; fi
    printf '  %s %-22s %s\n' "$mark" "$(label "$u")" "${s:-nomalum}"
  done
  h8="$(curl -s -m 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/health 2>/dev/null)"
  h3="$(curl -s -m 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:3000/login 2>/dev/null)"
  printf '  health: python=%s  web=%s\n' "${h8:-yoq}" "${h3:-yoq}"
}

cmd_start() {
  for u in "${UNITS[@]}"; do
    if [ "$(state "$u")" = "active" ]; then
      echo "  ✓ $(label "$u") allaqachon ishlayapti"
    else
      sc start "$u" && echo "  ▶ $(label "$u") yoqildi" || echo "  ✗ $(label "$u") yoqilmadi"
    fi
  done
  sleep 2
  show_status
}

cmd_stop() {
  for ((i=${#UNITS[@]}-1; i>=0; i--)); do
    u="${UNITS[$i]}"
    sc stop "$u" && echo "  ■ $(label "$u") to'xtatildi" || echo "  ✗ $(label "$u") to'xtamadi"
  done
  echo "To'xtatildi. Kompyuter qayta yoqilganda yana o'zi ishga tushadi; hozir yoqish: mrai start"
}

case "${1:-status}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_stop; echo; cmd_start ;;
  status)  show_status ;;
  logs)    tail -n 40 -f "$LOG_DIR/systemd.log" "$LOG_DIR/web.log" "$LOG_DIR/edge.log" ;;
  *)       echo "Ishlatilishi: mrai start | stop | restart | status | logs"; exit 1 ;;
esac
