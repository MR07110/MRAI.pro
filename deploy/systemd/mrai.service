[Unit]
Description=MR AI local server (Python) — code in MRAI, data in ~/.mrai
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/muhamad/Claude/work/MRAI/server
ExecStart=/home/muhamad/Claude/work/MRAI/server/start.sh
Restart=always
RestartSec=5
StandardOutput=append:/home/muhamad/.mrai/logs/server.log
StandardError=append:/home/muhamad/.mrai/logs/server.log

[Install]
WantedBy=default.target
