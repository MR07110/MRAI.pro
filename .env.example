# Sirlar faqat env orqali beriladi (kodda YO'Q). Lokal: .env.local, Vercel: Settings -> Environment Variables.

# Local MR AI serverning (Python) tokeni: ~/MR/mrai/token.key bilan BIR XIL bo'lishi shart.
MRAI_AUTH_TOKEN=

# Saytga kirish kaliti env'da EMAS: lokal serverda ~/MR/mrai/access.key faylida saqlanadi (o'zgartirish uchun faylni tahrirlang, restart shart emas).

# Local server manzili (ngrok). MAJBURIY: kodda standart manzil yo'q.
MRAI_SERVER_URL=

# Token yuboriladigan qo'shimcha hostlar (vergul bilan), odatda kerak emas.
# MRAI_ALLOWED_HOSTS=
