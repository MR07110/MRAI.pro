# Sirlar faqat env orqali beriladi (kodda YO'Q). Lokal: .env.local, Vercel: Settings -> Environment Variables.

# Local MR AI serverning (Python) tokeni: ~/MR/mrai/token.key bilan BIR XIL bo'lishi shart.
MRAI_AUTH_TOKEN=

# Saytga kirish kaliti (login sahifasi). Sozlanmasa production yopiq turadi.
MRAI_ACCESS_KEY=

# Local server manzili (ngrok). Berilmasa default ishlatiladi.
# MRAI_SERVER_URL=https://your-tunnel.ngrok-free.dev

# Token yuboriladigan qo'shimcha hostlar (vergul bilan), odatda kerak emas.
# MRAI_ALLOWED_HOSTS=
